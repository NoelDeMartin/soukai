{
    "private": true,
    "scripts": {
        "build": "vp run -r build",
        "docs:build": "vp run docs:build:typedoc && vp run docs:build:vitepress",
        "docs:build:typedoc": "cp ./docs/api/index.md ./docs/api-index.md.backup && typedoc --options ./docs/typedoc.json && mv ./docs/api-index.md.backup ./docs/api/index.md",
        "docs:build:vitepress": "vitepress build docs",
        "docs:dev": "vitepress dev docs"
    },
    "devDependencies": {
        "@noeldemartin/scripts": "catalog:",
        "@noeldemartin/testing": "catalog:",
        "@noeldemartin/utils": "catalog:",
        "@noeldemartin/vite-plus-config": "catalog:",
        "@tsconfig/node26": "^26.0.1",
        "@types/node": "^26.6.3",
        "@types/webpack-env": "^1.18.8",
        "typedoc": "^0.28.1",
        "typedoc-plugin-frontmatter": "^1.3.0",
        "typedoc-plugin-markdown": "^4.6.0",
        "typescript": "~6.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitepress": "^1.6.3"
    },
    "packageManager": "pnpm@12.8.1"
}
